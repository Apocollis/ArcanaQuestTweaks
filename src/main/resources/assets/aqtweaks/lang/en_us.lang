item.aqtweaks.spatial_rift_tear.name=Arcane Tunnel
item.aqtweaks.spatial_rift_tear.name_linked=Linked Arcane Tunnel
item.aqtweaks.spatial_rift_tear.lore=§dPulls the arcane threads between places to open a temporary tunnel between them. Attune to a destination to open a rift back to that point.
item.aqtweaks.spatial_rift_tear.unbound=§7Unbound. Right-click in air to mark this place.
item.aqtweaks.spatial_rift_tear.bound=Bound: %d, %d, %d (dim %d)
item.aqtweaks.spatial_rift_tear.shift=Sneak-use unbinds. Air-use attunes this place (unbound) or opens a 60s rift at the bound point (linked). Standing pets and leads follow; sitting pets stay.
item.aqtweaks.spatial_rift_tear.shift_hint=§8Hold Shift for details.
item.aqtweaks.spatial_rift_tear.attuned=§5[Arcana]§r §dAttuned Arcane Tunnel to X: %d, Y: %d, Z: %d.
item.aqtweaks.spatial_rift_tear.cleared=§5[Arcana]§r §7Cleared Arcane Tunnel attunement.
item.aqtweaks.spatial_rift_tear.failed=§5[Arcana]§r The rift failed to open.
item.aqtweaks.spatial_rift_tear.missing_dim=§5[Arcana]§r The bound dimension is not loaded.
item.aqtweaks.spatial_rift_wild.name=Unstable Arcane Tunnel
item.aqtweaks.spatial_rift_wild.lore=§dDistorts arcane energy to open a tunnel between the current location and another random point in the same dimension.
item.aqtweaks.spatial_rift_wild.shift=§8Air-use opens a red rift pair 4000-6000 blocks away. Standing pets and leads follow; sitting pets stay.
item.aqtweaks.spatial_rift_wild.shift_hint=§8Hold Shift for details.
item.aqtweaks.spatial_rift_wild.no_land=§5[Arcana]§r No safe land was found.
